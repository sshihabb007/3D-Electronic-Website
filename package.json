{
  "name": "3d-electronics-ecommerce",
  "version": "1.0.0",
  "description": "3D Interactive Electronics E-Commerce Platform built with NestJS, MySQL, Tailwind CSS, Vanilla JS, and Three.js",
  "author": "Antigravity",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "db:backup": "d:/xampp/mysql/bin/mysqldump.exe -h 127.0.0.1 -P 3306 -u root --databases 3d_electronics_db --add-drop-database --add-drop-table --default-character-set=utf8mb4 --result-file=database-backup/3d_electronics_db_backup.sql"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/typeorm": "^10.0.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.2",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@types/bcryptjs": "^2.4.6",
